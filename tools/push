#!/bin/sh
# Push all firmware files to the Pico over WiFi and reboot it.
# Requires ENABLE_NETWORK_CONSOLE=True and is unsafe while the wallet holds value.
cd "$(dirname "$0")/.." || exit 1
for f in firmware/*.py; do
  case "$f" in *secrets.example.py|*/splash.py|*/lcd.py|*/loader.py) continue;; esac
  ./tools/pico cp "$f" ":$(basename "$f")" || exit 1
done
# the bootloader: pre-compiled modules plus the logo and bar art. Rebuild the .mpy first so an
# edited .py is never shadowed by old bytecode; without mpy-cross, send the .py instead. A .py left
# on the board would be imported instead of its .mpy, so it is removed.
if ./tools/mpy >/dev/null 2>&1; then
  for f in firmware/splash.mpy firmware/lcd.mpy firmware/loader.mpy; do
    ./tools/pico cp "$f" ":$(basename "$f")" || exit 1
  done
  ./tools/pico exec 'import os
for f in ("splash.py", "lcd.py", "loader.py"):
    try: os.remove(f)
    except OSError: pass'
else
  echo "no mpy-cross (uv tool install mpy-cross==1.26.1.post2): sending the bootloader as .py"
  for f in firmware/splash.py firmware/lcd.py firmware/loader.py; do
    ./tools/pico cp "$f" ":$(basename "$f")" || exit 1
  done
  ./tools/pico exec 'import os
for f in ("splash.mpy", "lcd.mpy", "loader.mpy"):
    try: os.remove(f)
    except OSError: pass'
fi
for f in firmware/logo.bin firmware/bar.bin; do
  ./tools/pico cp "$f" ":$(basename "$f")" || exit 1
done
# schedule the reset so mpremote returns before the socket drops
./tools/pico exec 'import machine; machine.Timer(period=300, mode=machine.Timer.ONE_SHOT, callback=lambda t: machine.reset())'
echo "pushed, rebooting"
