#!/usr/bin/env python3
# Boot logo: turn an image into firmware/logo.bin, the raw 240x240 RGB565 frame the screen takes
# (big-endian, row by row, the same bytes lcd.py's framebuffer holds). The image goes in at half
# size (LOGO px square), leaving room below for the loading bar (tools/bar); the rest
# is the image's corner colour. Also writes art/logo_screen.png, a 2x preview of what the screen shows.
#   tools/logo [image] [out.bin]        defaults: art/logo.jpg -> firmware/logo.bin
import sys
from pathlib import Path
from PIL import Image

root = Path(__file__).resolve().parent.parent
src = Path(sys.argv[1]) if len(sys.argv) > 1 else root / "art/logo.jpg"
out = Path(sys.argv[2]) if len(sys.argv) > 2 else root / "firmware/logo.bin"
W = H = 240

LOGO, LOGO_Y = 120, 50

im = Image.open(src).convert("RGB")
bg = im.getpixel((0, 0))
im.thumbnail((LOGO, LOGO), Image.LANCZOS)
frame = Image.new("RGB", (W, H), bg)
frame.paste(im, ((W - im.width) // 2, LOGO_Y + (LOGO - im.height) // 2))

data, shown = bytearray(), Image.new("RGB", (W, H))
for y in range(H):
    for x in range(W):
        r, g, b = frame.getpixel((x, y))
        c = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3)
        data += bytes((c >> 8, c & 0xFF))
        shown.putpixel((x, y), ((c >> 11) << 3, ((c >> 5) & 63) << 2, (c & 31) << 3))
out.write_bytes(data)
preview = root / "art/logo_screen.png"
shown.resize((W * 2, H * 2), Image.NEAREST).save(preview)
print(f"{out} ({len(data)} bytes), preview {preview}")
